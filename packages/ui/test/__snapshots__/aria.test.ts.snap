// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`preserves form semantics when validation appears and clears 1`] = `
- document:
  - /children: deep-equal
  - main:
    - form "Workout":
      - group:
        - text: Workout name
        - textbox "Workout name": Morning
        - paragraph: Shown in your list.
      - group:
        - text: Repetitions
        - spinbutton "Repetitions": "8"
      - group:
        - text: Locked value
        - textbox "Locked value" [disabled]: hidden
      - button "Save"
      - button "Reset"
      - button "Unavailable" [disabled]
    - button "Set name"
    - button "Toggle error"
    - link "Documentation":
      - /url: "#destination"
    - status "Current name": Morning
    - status "Submitted values"
`;

