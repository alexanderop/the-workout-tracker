exports[`preserves the accessible catalog of button and field variants 1`] = `
- document:
  - /children: deep-equal
  - main "Component states":
    - heading "Form UI" [level=1]
    - heading "Buttons" [level=2]
    - button "default"
    - button "destructive"
    - button "outline"
    - button "secondary"
    - button "ghost"
    - button "link"
    - button "default" [disabled]
    - button "destructive" [disabled]
    - button "outline" [disabled]
    - button "secondary" [disabled]
    - button "ghost" [disabled]
    - button "link" [disabled]
    - button "default"
    - button "xs"
    - button "sm"
    - button "lg"
    - button "icon": +
    - button "icon-xs": +
    - button "icon-sm": +
    - button "icon-lg": +
    - button "Focused outline"
    - heading "Fields" [level=2]
    - group:
      - text: Workout name
      - textbox "Workout name": Morning strength
      - paragraph: Shown in your workout list.
    - group:
      - text: Email address
      - textbox "Email address": invalid address
      - alert: Enter a valid email address.
    - group:
      - text: Unavailable
      - textbox "Unavailable" [disabled]: Managed by your coach
    - group:
      - text: A longer label that wraps naturally on smaller viewports
      - textbox "A longer label that wraps naturally on smaller viewports":
        - /placeholder: Enter a value
`;

