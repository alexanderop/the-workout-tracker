{
  "name": "the-workout-tracker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter @form/workout dev",
    "build": "pnpm typecheck && pnpm --filter @form/workout build",
    "preview": "pnpm --filter @form/workout preview",
    "typecheck": "pnpm typecheck:pure && pnpm typecheck:native && pnpm -r typecheck",
    "lint": "pnpm lint:oxlint && pnpm lint:vue",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify": "pnpm typecheck && pnpm lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "dev:ui": "node scripts/design-workspace.mjs dev",
    "build:ui": "node scripts/design-workspace.mjs build",
    "lint:oxlint": "pnpm -r lint",
    "lint:vue": "eslint \"apps/*/src/**/*.{vue,ts,css}\" \"packages/*/src/**/*.{vue,ts,css}\" --max-warnings 0",
    "typecheck:pure": "node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.pure.json",
    "typecheck:native": "node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.native.json",
    "test:unit": "pnpm --filter @form/ui test:unit && pnpm --filter @form/workout test:unit",
    "test:browser": "pnpm --filter @form/ui test:browser && pnpm --filter @form/workout test:browser",
    "test:e2e": "pnpm --filter @form/workout test:e2e",
    "test": "pnpm test:unit && pnpm test:browser && pnpm test:e2e",
    "performance:build": "node scripts/performance-vite.mjs build",
    "performance:serve": "node scripts/performance-vite.mjs serve",
    "performance:budget": "pnpm --filter @form/workout exec node scripts/check-performance-budgets.mjs",
    "performance:offline": "pnpm --filter @form/workout exec playwright test --config playwright.performance.config.ts",
    "performance:lighthouse": "lhci autorun",
    "performance:check": "pnpm performance:build && pnpm performance:budget && pnpm performance:offline && pnpm performance:lighthouse"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@lhci/cli": "0.15.1",
    "@shadcn/lint": "^0.2.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vue/compiler-sfc": "^3.5.43",
    "eslint": "^10.12.0",
    "eslint-plugin-oxlint": "^1.86.0",
    "eslint-plugin-vue": "^10.11.1",
    "husky": "^9.1.7",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
