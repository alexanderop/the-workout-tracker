{
  "name": "@form/workout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4180",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4180 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint src test *.config.ts --deny-warnings",
    "icons": "node scripts/icons.mjs",
    "routes:generate": "node scripts/generate-routes.mjs",
    "test:unit": "vitest run --project unit --coverage",
    "test:browser": "vitest run --project browser",
    "test:e2e": "bddgen && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@form/result": "workspace:*",
    "@form/ui": "workspace:*",
    "@lucide/vue": "^1.51.0",
    "dexie": "^4.4.6",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "5.3.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "fast-check": "^4.10.2",
    "playwright-bdd": "^9.2.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
